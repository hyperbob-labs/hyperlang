+safe_atom(Wcs) ->
+    unicode:characters_to_binary(Wcs).
+
+safe_var(Wcs) ->
+    unicode:characters_to_binary(Wcs).
+
+safe_sigil(Wcs) ->
+    unicode:characters_to_binary(Wcs).
+
+safe_non_verbatim_sigil(?NO_SIGIL) -> true;
+safe_non_verbatim_sigil('') -> true;
+safe_non_verbatim_sigil('b') -> true;
+safe_non_verbatim_sigil('s') -> true;
+safe_non_verbatim_sigil(<<>>) -> true;
+safe_non_verbatim_sigil(<<"b">>) -> true;
+safe_non_verbatim_sigil(<<"s">>) -> true;
+safe_non_verbatim_sigil(_) -> false.
+
+safe_string_thing(SigilType, Qs) ->
+    case SigilType of
+        ?NO_SIGIL -> {string,Qs};
+        _ -> {sigil,SigilType,Qs}
+    end.
+
+safe_string_thing(SigilType, Q1, Q2) ->
+    case SigilType of
+        ?NO_SIGIL -> string;
+        _ -> {sigil,SigilType,Q1,Q2}
+    end.
+
+safe_punctuation(Str) ->
+    case Str of
+        "&" -> '&';
+        "." -> '.';
+        _ -> false
+    end.
+
+safe_reserved_word(Wcs, RWFun) ->
+    try list_to_existing_atom(Wcs) of
+        Name ->
+            case RWFun(Name) of
+                true -> Name;
+                false -> false
             end
+    catch
+        _:_ -> false
     end.
 
 
